# Copy to .env and set unique high-entropy values before deploying.
# In production SESSION_SECRET must be set and must not equal the development fallback.
SESSION_SECRET=replace-with-at-least-32-random-bytes
NODE_ENV=development
PORT=4179
HOST=127.0.0.1
COOKIE_SECURE=false
ENABLE_DEV_TOOLS=true
# Each CTF receives its own shared secret, set only on the hub and the CTF server.
CTF_SECRET_YELLOW_01=replace-with-unique-secret
CTF_SECRET_YELLOW_02=replace-with-unique-secret
CTF_SECRET_YELLOW_03=replace-with-unique-secret
CTF_SECRET_BLUE_01=replace-with-unique-secret
CTF_SECRET_BLUE_02=replace-with-unique-secret
CTF_SECRET_BLUE_03=replace-with-unique-secret
CTF_SECRET_ORANGE_01=replace-with-unique-secret
CTF_SECRET_ORANGE_02=replace-with-unique-secret
CTF_SECRET_ORANGE_03=replace-with-unique-secret
CTF_SECRET_RED_01=replace-with-unique-secret
CTF_SECRET_RED_02=replace-with-unique-secret
CTF_SECRET_RED_03=replace-with-unique-secret
CTF_SECRET_PURPLE_01=replace-with-unique-secret
CTF_SECRET_PURPLE_02=replace-with-unique-secret
CTF_SECRET_PURPLE_03=replace-with-unique-secret

# Required for Vercel/serverless deployments. Connect Upstash Redis and set these in Vercel.
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-with-the-instance-token
# UPSTASH_STATE_KEY=last-dataset-map-hub:state:v1
